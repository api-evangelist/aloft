{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aloft API V1 Accounts Tags API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Gets tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.aloft.ai/v1/account/:account_id/tags",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "applies_to[]",
                "value": "",
                "type": "query",
                "description": "Array of models you want to filter tag groups by"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "The field to order the data by"
              },
              {
                "name": "order",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_length",
                "value": "",
                "type": "query"
              },
              {
                "name": "appends[]",
                "value": "",
                "type": "query",
                "description": "Array of appendable resource names"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets tags"
        },
        {
          "info": {
            "name": "Create a tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.aloft.ai/v1/account/:account_id/tags",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "appends[]",
                "value": "",
                "type": "query",
                "description": "Array of appendable resource names"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a tag"
        },
        {
          "info": {
            "name": "Gets a single tag",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.aloft.ai/v1/account/:account_id/tags/:tag_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "tag_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "appends[]",
                "value": "",
                "type": "query",
                "description": "Array of appendable resource names"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets a single tag"
        },
        {
          "info": {
            "name": "Updates a tag",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.aloft.ai/v1/account/:account_id/tags/:tag_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "tag_id",
                "value": "",
                "type": "path",
                "description": "The id of the tag."
              },
              {
                "name": "appends[]",
                "value": "",
                "type": "query",
                "description": "Array of appendable resource names"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates a tag"
        },
        {
          "info": {
            "name": "Delete a tag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.aloft.ai/v1/account/:account_id/tags/:tag_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "tag_id",
                "value": "",
                "type": "path",
                "description": "The id of the tag."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This will completely remove the tag and any associations with the tag.  It will not delete the associated objects."
        }
      ]
    }
  ],
  "bundled": true
}