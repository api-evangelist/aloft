              },
              {
                "name": "lng",
                "value": "-97.6676542081379",
                "type": "query"
              },
              {
                "name": "lat",
                "value": "30.15616435627915",
                "type": "query"
              },
              {
                "name": "advisory_types[]",
                "value": "",
                "type": "query",
                "description": "Array of airspace advisory types to limit the request to. Providing nothing will return everything"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets advisories close to a given lat / lng"
        },
        {
