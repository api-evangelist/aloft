            "method": "POST",
            "url": "https://api.aloft.ai/v1/account/:account_id/tag-groups",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "appends[]",
                "value": "",
                "type": "query",
                "description": "Array of appendable resource names"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a tag group"
        },
        {
