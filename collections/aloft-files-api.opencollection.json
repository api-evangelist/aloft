{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aloft API V1 Accounts Files API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Files",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all files",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.aloft.ai/v1/account/:account_id/files",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "The field to order the data by"
              },
              {
                "name": "order",
                "value": "",
                "type": "query"
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Only return files created before this date"
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Only return files created after this date"
              },
              {
                "name": "file_association_type",
                "value": "",
                "type": "query",
                "description": "The owner of the file's type, for example: flight, aircraft, etc."
              },
              {
                "name": "file_association_id",
                "value": "",
                "type": "query",
                "description": "The id of the file_association_type resource to query for"
              },
              {
                "name": "document_type",
                "value": "",
                "type": "query",
                "description": "File type. Can be: document, media or flight_log"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "File type. Can be: flight-image, dji, etc.."
              },
              {
                "name": "extension",
                "value": "",
                "type": "query",
                "description": "File extension. Such as jpg, pdf, csv, etc."
              },
              {
                "name": "appends[]",
                "value": "",
                "type": "query",
                "description": "Array of appendable resource names"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_length",
                "value": "",
                "type": "query"
              },
              {
                "name": "tags[]",
                "value": "",
                "type": "query",
                "description": "array of tag ids"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all files"
        },
        {
          "info": {
            "name": "Upload a file",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.aloft.ai/v1/account/:account_id/files",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "appends[]",
                "value": "",
                "type": "query",
                "description": "Array of appendable resource names"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": []
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Upload a file"
        },
        {
          "info": {
            "name": "Get a file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.aloft.ai/v1/account/:account_id/files/:file_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "file_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "appends[]",
                "value": "",
                "type": "query",
                "description": "Array of appendable resource names"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a file"
        },
        {
          "info": {
            "name": "Update a file",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.aloft.ai/v1/account/:account_id/files/:file_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "file_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a file"
        },
        {
          "info": {
            "name": "Delete a file",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.aloft.ai/v1/account/:account_id/files/:file_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "file_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a file"
        },
        {
          "info": {
            "name": "Download multiple files",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.aloft.ai/v1/account/:account_id/files/bulk",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "id[]",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Download a compressed archive of multiple files"
        },
        {
          "info": {
            "name": "Get a file's thumbnail view",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.aloft.ai/v1/account/:account_id/files/:file_id/thumbnail",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "file_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Files Thumbnail"
        },
        {
          "info": {
            "name": "Download a file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.aloft.ai/v1/account/:account_id/files/:file_id/download",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "file_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Files Download"
        },
        {
          "info": {
            "name": "View a file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.aloft.ai/v1/account/:account_id/files/:file_id/view",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "file_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Files Thumbnail"
        }
      ]
    }
  ],
  "bundled": true
}